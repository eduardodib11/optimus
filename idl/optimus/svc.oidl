// Protocolo entre os serviços e o `svcmgr` (ADR 0034, item 6). O código
// à mão em lib/osvc segue esta especificação até os stubs gerados.
package optimus.svc @1.4;

struct CapDesc { kind: u8, index: u16, handle: u32, name_hash: u32 }
struct Boot { caps: vec<CapDesc, 96>, generation: u16 }
enum SvcError : u8 { NotInManifest, NotRunning, VersionTooOld, Busy }
// Um driver do conjunto compilado (ADR 0042, item 3): `rules` são os nomes
// das necessidades `dev:` (as regras de `[match]`).
struct DriverInfo { id: u32, total: u16, name: string<31>, rules: vec<string<63>, 16> }

interface Supervisor {
    bootstrap() -> result<Boot, SvcError>;
    ready() -> result<(), SvcError>;
    connect(interface: u32, minor: u16) -> result<handle<Endpoint>, SvcError>;
    name_of(id: u32) -> result<string<31>, SvcError>;
    // Nasce na 1.1 (`minor_min` 1): só o `devmgr` (quem provê
    // `optimus.dev.DeviceBus`) recebe.
    driver(index: u16) -> result<DriverInfo, SvcError>;
    // Nascem na 1.2, também só para o `devmgr`: os recursos de um driver
    // vão com a mensagem (até 4 capabilities, na ordem de `names`, o hash
    // de cada nome) e depois o pedido de partida.
    driver_give(id: u32, names: vec<u32, 4>) -> result<(), SvcError>;
    driver_start(id: u32) -> result<(), SvcError>;
    // Nasce na 1.3, só para o `devmgr`: para o driver de `id`.
    driver_stop(id: u32) -> result<(), SvcError>;
    // Nasce na 1.4 (T-637; ADR 0068, item 2), só para quem provê
    // `optimus.net.Socket` (o `netd`): o texto da necessidade `net:access:` do
    // manifesto do serviço `id`, sem o prefixo; vazio se não tem (sem política,
    // nada é permitido).
    net_policy(id: u32) -> result<string<480>, SvcError>;
}
