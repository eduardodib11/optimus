package optimus.net @2.3;

type Porta = u16;
open enum Estado : u8 { Ocioso, Ativo = 5 }
flags Modo : u32 { Leitura = 1, Escrita = 2 }
struct Par { a: i64, b: bool, c: optimus.core.Timestamp }
interface Socket {
    oneway aviso(codigo: u8);
    @tool(risk = R4, desc = "Abre \"conexão\"\n")
    conectar(alvo: handle<Endpoint>, p: Porta) -> result<vec<Par, 4>, Estado>;
    fechar() -> result<(), Estado>;
    oneway vazio();
}
interface Vazia {}
